<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true"
    android:scrollbars="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="18dp"
        android:paddingEnd="18dp"
        android:paddingBottom="28dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/title"
            android:textColor="@color/text_primary"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:lineSpacingExtra="2dp"
            android:text="@string/subtitle"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <LinearLayout
            style="@style/GoPlayCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/section_connection"
                style="@style/CardTitle" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/host_label"
                style="@style/FieldLabel" />

            <EditText
                android:id="@+id/hostInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/host_hint"
                android:inputType="textUri"
                android:maxLines="1"
                style="@style/GoPlayInput" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/port_label"
                        style="@style/FieldLabel" />

                    <EditText
                        android:id="@+id/portInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:maxLength="5"
                        android:maxLines="1"
                        style="@style/GoPlayInput" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1.6"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/instance_label"
                        style="@style/FieldLabel" />

                    <EditText
                        android:id="@+id/instanceInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:maxLines="1"
                        style="@style/GoPlayInput" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/qualityLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/quality_label"
                style="@style/FieldLabel" />

            <SeekBar
                android:id="@+id/qualitySeek"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:max="95"
                android:progress="70" />

            <TextView
                android:id="@+id/fpsLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/fps_label"
                style="@style/FieldLabel" />

            <SeekBar
                android:id="@+id/fpsSeek"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:max="29"
                android:progress="9" />

            <TextView
                android:id="@+id/maxEdgeLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/max_edge_label"
                style="@style/FieldLabel" />

            <SeekBar
                android:id="@+id/maxEdgeSeek"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:max="3"
                android:progress="1" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/wifiOnlySwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:checked="true"
                android:text="@string/wifi_only"
                style="@style/GoPlaySwitch" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/autoReconnectSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/auto_reconnect"
                style="@style/GoPlaySwitch" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/saveButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:text="@string/save"
                    style="@style/GoPlayButton.Secondary" />

                <Button
                    android:id="@+id/connectButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/connect"
                    style="@style/GoPlayButton" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            style="@style/GoPlayCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/section_permissions"
                style="@style/CardTitle" />

            <TextView
                android:id="@+id/overlayStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/overlay_perm_default"
                style="@style/StatusText" />

            <Button
                android:id="@+id/overlayButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/grant_overlay"
                style="@style/GoPlayButton.Secondary" />

            <TextView
                android:id="@+id/accessibilityStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/accessibility_perm_default"
                style="@style/StatusText" />

            <Button
                android:id="@+id/accessibilityButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/open_accessibility"
                style="@style/GoPlayButton.Secondary" />

            <TextView
                android:id="@+id/notificationStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/notification_perm_default"
                style="@style/StatusText" />

            <Button
                android:id="@+id/notificationButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/grant_notification"
                style="@style/GoPlayButton.Secondary" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/startCaptureButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:text="@string/start_capture"
                    style="@style/GoPlayButton" />

                <Button
                    android:id="@+id/stopCaptureButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/stop_capture"
                    style="@style/GoPlayButton.Danger" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            style="@style/GoPlayCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/section_session"
                style="@style/CardTitle" />

            <TextView
                android:id="@+id/sessionStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/session_default"
                style="@style/StatusText" />

            <TextView
                android:id="@+id/captureStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/capture_default"
                style="@style/StatusText" />

            <TextView
                android:id="@+id/metricsStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/metrics_default"
                style="@style/StatusText" />

            <TextView
                android:id="@+id/errorStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/error_default"
                android:textColor="@color/state_warn"
                style="@style/StatusText" />
        </LinearLayout>

        <LinearLayout
            style="@style/GoPlayCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/section_local"
                style="@style/CardTitle" />

            <TextView
                android:id="@+id/deviceInfoView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/device_default"
                style="@style/StatusText" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="2dp"
                android:text="@string/local_note"
                android:textColor="@color/text_muted"
                android:textSize="12sp" />

            <Button
                android:id="@+id/queryLocalButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/query_local"
                style="@style/GoPlayButton.Secondary" />

            <TextView
                android:id="@+id/localResultView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_result"
                android:fontFamily="monospace"
                android:padding="10dp"
                android:text="@string/local_result_default"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            style="@style/GoPlayCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/section_chat"
                style="@style/CardTitle" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/messageInput"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="@string/chat_hint"
                    android:inputType="text"
                    android:maxLines="1"
                    style="@style/GoPlayInput" />

                <Button
                    android:id="@+id/sendButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/send"
                    style="@style/GoPlayButton" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            style="@style/GoPlayCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/section_log"
                style="@style/CardTitle" />

            <TextView
                android:id="@+id/logView"
                android:layout_width="match_parent"
                android:layout_height="150dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_result"
                android:fontFamily="monospace"
                android:gravity="bottom"
                android:padding="8dp"
                android:scrollbars="vertical"
                android:textColor="@color/text_secondary"
                android:textSize="10sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:lineSpacingExtra="3dp"
            android:text="@string/footer"
            android:textColor="@color/text_muted"
            android:textSize="11sp" />
    </LinearLayout>
</ScrollView>
